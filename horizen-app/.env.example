# Copy to .env and adjust. Anything prefixed EXPO_PUBLIC_ is bundled into the app,
# so never put secret keys here.

# mock (default) = bundled sample data, api = the Horizen backend
EXPO_PUBLIC_DATA_SOURCE=mock

# Horizen backend base URL (used when EXPO_PUBLIC_DATA_SOURCE=api)
# EXPO_PUBLIC_API_URL=https://api.horizengym.co.za

# Currency for sample prices (ISO 4217)
# EXPO_PUBLIC_CURRENCY=ZAR

# Preview the "EXPIRED" membership state with sample data
# EXPO_PUBLIC_MOCK_MEMBERSHIP=expired
