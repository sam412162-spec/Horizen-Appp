# ─── Server ─────────────────────────────────────────────
PORT=3000
# Public HTTPS address of this API (Paystack sends members back here after paying)
PUBLIC_URL=https://api.horizengym.co.za

# ─── Database ───────────────────────────────────────────
# Production: a Postgres connection string. Leave empty in development to use
# the built-in PGlite database stored in DATA_DIR.
DATABASE_URL=
DATA_DIR=.data/pglite

# ─── Gym ────────────────────────────────────────────────
GYM_TIME_ZONE=Africa/Johannesburg
CURRENCY=ZAR

# ─── Paystack ───────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_… until you go live.
# Set the webhook URL there to: <PUBLIC_URL>/webhooks/paystack
PAYSTACK_SECRET_KEY=

# ─── Security ───────────────────────────────────────────
# App deep links Paystack may return members to (comma separated)
ALLOWED_RETURN_URL_PREFIXES=horizen://,exp://,exps://
# Browser origins allowed to call the API (the admin panel, later)
CORS_ORIGINS=
SESSION_DAYS=90

# Run scheduled jobs (class sessions, renewals, auto check-out) in this process.
# Set to false if you run `npm run jobs:run` from an external cron instead.
RUN_JOBS=true
